# ---------------------------------------------
# ShopKart Authentication Service - Environment
# Copy this file to .env and fill in real values
#   cp .env.example .env
# ---------------------------------------------

# Port the Express server listens on. The React frontend calls
# http://localhost:8000 by default, and macOS reserves 5000 for AirPlay.
PORT=8000

# Runtime environment: development | production
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/shopkart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopkart
MONGODB_URI=mongodb://127.0.0.1:27017/shopkart

# Secret used to sign JWTs - use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# JWT lifetime (also used as the auth cookie max age)
JWT_EXPIRES_IN=7d

# Origin of the React frontend, allowed by CORS (credentials enabled)
CLIENT_URL=http://localhost:5173

# Razorpay TEST MODE keys (Dashboard → Account & Settings → API Keys, test mode)
# Never commit real keys. Only rzp_test_ keys are accepted by this lab.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
